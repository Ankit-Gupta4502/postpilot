{
  "name": "postpilot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter=@postpilot/api run dev",
    "dev:web": "pnpm --filter=@postpilot/web run dev",
    "dev:worker": "pnpm --filter=@postpilot/queue-worker run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter=@postpilot/db run db:generate",
    "db:migrate": "pnpm --filter=@postpilot/db run db:migrate",
    "db:studio": "pnpm --filter=@postpilot/db run db:studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  }
}
